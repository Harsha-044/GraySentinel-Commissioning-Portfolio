###############################################################################
# GraySentinel Local Suricata Rules
#
# Author : Harsha
# Version: 1.0
#
# Purpose:
# Initial custom detection rules created during GraySentinel Cyber Range
#
# IDS:
# Suricata v8.0.5
#
# Environment:
# Kali Linux + Windows Lab Network
#
###############################################################################


###############################################################################
# 1. ICMP Echo Request Detection
#
# Purpose:
# Detect ICMP ping activity used for host discovery
#
# Tested During:
# Network reconnaissance phase
###############################################################################

alert icmp any any -> $HOME_NET any (
    msg:"GRAY SENTINEL ICMP Echo Request Detected";
    icmp_type:8;
    sid:1000001;
    rev:1;
)


###############################################################################
# 2. Nmap SYN Scan Detection
#
# Purpose:
# Detect TCP SYN scanning activity
#
# Tested During:
# Nmap reconnaissance exercises
###############################################################################

alert tcp any any -> $HOME_NET any (
    msg:"GRAY SENTINEL Nmap SYN Scan Detected";
    flags:S;
    threshold:type both, track by_src, count 20, seconds 10;
    classtype:network-scan;
    sid:1000002;
    rev:1;
)


###############################################################################
# 3. Web Directory Brute Force Detection
#
# Purpose:
# Detect suspicious directory enumeration attempts
#
# Related Tools:
# Gobuster
# Dirb
# FFUF
###############################################################################

alert http any any -> $HOME_NET any (
    msg:"GRAY SENTINEL Possible Directory Brute Force Attempt";
    http.uri;
    pcre:"/(\.git|\.htaccess|\.htpasswd|admin|backup)/i";
    classtype:web-application-attack;
    sid:1000003;
    rev:1;
)


###############################################################################
# 4. IP Fragmentation Detection
#
# Purpose:
# Detect fragmented packets that may affect inspection
#
# Tested During:
# Network evasion analysis
###############################################################################

alert ip any any -> $HOME_NET any (
    msg:"GRAY SENTINEL IP Fragmentation Detected";
    fragbits:M;
    classtype:attempted-recon;
    sid:1000004;
    rev:1;
)


###############################################################################
# 5. HTTP Data Exfiltration Detection
#
# Purpose:
# Detect large HTTP POST transfers
#
# Tested During:
# Data exfiltration simulation
###############################################################################

alert http any any -> $HOME_NET any (
    msg:"GRAY SENTINEL Possible HTTP Data Exfiltration";
    flow:established,to_server;
    http.method;
    content:"POST";
    dsize:>500;
    classtype:exfiltration;
    sid:1000005;
    rev:1;
)


###############################################################################
# 6. Suspicious Executable Download Detection
#
# Purpose:
# Detect executable file transfers over HTTP
#
# Related Activity:
# Malware traffic analysis exercise
###############################################################################

alert http any any -> $HOME_NET any (
    msg:"GRAY SENTINEL Suspicious EXE File Download Detected";
    http.uri;
    content:".exe";
    nocase;
    classtype:trojan-activity;
    sid:1000006;
    rev:1;
)


###############################################################################
# 7. SMB Connection Monitoring
#
# Purpose:
# Detect SMB access attempts
#
# Related Activity:
# SMB Enumeration
# EternalBlue Analysis
###############################################################################

alert tcp any any -> $HOME_NET 445 (
    msg:"GRAY SENTINEL SMB Connection Attempt Detected";
    flags:S;
    threshold:type threshold, track by_src, count 5, seconds 30;
    classtype:attempted-recon;
    sid:1000007;
    rev:1;
)


###############################################################################
# 8. DNS Long Query Detection
#
# Purpose:
# Detect possible DNS tunneling behaviour
#
# Related Activity:
# DNS Exfiltration Experiment
###############################################################################

alert dns any any -> $HOME_NET any (
    msg:"GRAY SENTINEL Possible DNS Tunneling Activity";
    dns.query;
    pcre:"/[A-Za-z0-9]{40,}/";
    classtype:exfiltration;
    sid:1000008;
    rev:1;
)


###############################################################################
# Rule Summary
###############################################################################

# Total Rules: 8
#
# Covered Detections:
#
# 1. ICMP Discovery
# 2. Nmap SYN Scan
# 3. Directory Enumeration
# 4. IP Fragmentation
# 5. HTTP Exfiltration
# 6. Executable Downloads
# 7. SMB Activity
# 8. DNS Tunneling Indicators
#
###############################################################################
# End of GraySentinel Local Rules
###############################################################################
